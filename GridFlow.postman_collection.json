{
  "info": {"name":"GridFlow API","description":"Import this collection in Postman. Login requests save access/refresh tokens automatically. Replace IDs in collection variables as resources are created.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[
    {"key":"baseUrl","value":"http://localhost:5000/api/v1"},{"key":"accessToken","value":""},{"key":"refreshToken","value":""},
    {"key":"zoneId","value":""},{"key":"substationId","value":""},{"key":"feederId","value":""},{"key":"areaId","value":""},{"key":"userId","value":""},{"key":"outageId","value":""},{"key":"assignmentId","value":""},{"key":"scheduleId","value":""},{"key":"jobPostId","value":""},{"key":"applicationId","value":""},{"key":"announcementId","value":""},{"key":"priorityRequestId","value":""}
  ],
  "auth":{"type":"bearer","bearer":[{"key":"token","value":"{{accessToken}}","type":"string"}]},
  "item":[
    {"name":"Health","item":[{"name":"Welcome","request":{"method":"GET","auth":{"type":"noauth"},"url":"{{baseUrl}}/../"}}]},
    {"name":"Auth","item":[
      {"name":"Register Customer","request":{"method":"POST","auth":{"type":"noauth"},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"New Customer\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"Demo@1234\",\n  \"areaId\": \"{{areaId}}\"\n}"},"url":"{{baseUrl}}/auth/register"}},
      {"name":"Verify Email","request":{"method":"POST","auth":{"type":"noauth"},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"customer@example.com\",\n  \"otp\": \"123456\"\n}"},"url":"{{baseUrl}}/auth/verify-email"},"event":[{"listen":"test","script":{"exec":["const d=pm.response.json().data; if(d?.accessToken){pm.collectionVariables.set('accessToken',d.accessToken);pm.collectionVariables.set('refreshToken',d.refreshToken);}"]}}]},
      {"name":"Login (saves tokens)","request":{"method":"POST","auth":{"type":"noauth"},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Demo@1234\"\n}"},"url":"{{baseUrl}}/auth/login"},"event":[{"listen":"test","script":{"exec":["const d=pm.response.json().data; if(d?.accessToken){pm.collectionVariables.set('accessToken',d.accessToken);pm.collectionVariables.set('refreshToken',d.refreshToken);}"]}}]},
      {"name":"Me","request":{"method":"GET","url":"{{baseUrl}}/auth/me"}},{"name":"Refresh Token","request":{"method":"POST","header":[{"key":"Cookie","value":"refreshToken={{refreshToken}}"}],"url":"{{baseUrl}}/auth/refresh-token"}},{"name":"Logout","request":{"method":"POST","url":"{{baseUrl}}/auth/logout"}},
      {"name":"Google Login","request":{"method":"POST","auth":{"type":"noauth"},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"googleId\":\"GOOGLE_ID_TOKEN\"}"},"url":"{{baseUrl}}/auth/google"}},{"name":"Forgot Password","request":{"method":"POST","auth":{"type":"noauth"},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"customer@example.com\"}"},"url":"{{baseUrl}}/auth/forgot-password"}},{"name":"Reset Password","request":{"method":"POST","auth":{"type":"noauth"},"header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"customer@example.com\",\"otp\":\"123456\",\"newPassword\":\"NewDemo@1234\"}"},"url":"{{baseUrl}}/auth/reset-password"}}
    ]},
    {"name":"Infrastructure (Admin)","item":[
      {"name":"Create Zone","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Dhaka North\"}"},"url":"{{baseUrl}}/zone/create-zone"}},{"name":"List Zones","request":{"method":"GET","url":"{{baseUrl}}/zone/all-zones"}},{"name":"Get/Update/Delete Zone","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Dhaka North Updated\"}"},"url":"{{baseUrl}}/zone/update-zone/{{zoneId}}"}},
      {"name":"Create Substation","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Mirpur Substation\",\"powerZoneId\":\"{{zoneId}}\"}"},"url":"{{baseUrl}}/substation/create-substation"}},{"name":"List Substations","request":{"method":"GET","url":"{{baseUrl}}/substation/all-substations"}},{"name":"Update Substation","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Mirpur Updated\"}"},"url":"{{baseUrl}}/substation/update-substation/{{substationId}}"}},{"name":"Delete Substation","request":{"method":"DELETE","url":"{{baseUrl}}/substation/delete-substation/{{substationId}}"}},
      {"name":"Create Feeder","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Feeder 1\",\"substationId\":\"{{substationId}}\"}"},"url":"{{baseUrl}}/feeder/create-feeder"}},{"name":"List Feeders","request":{"method":"GET","url":"{{baseUrl}}/feeder/all-feeders"}},{"name":"Update Feeder","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Feeder 1 Updated\"}"},"url":"{{baseUrl}}/feeder/update-feeder/{{feederId}}"}},{"name":"Delete Feeder","request":{"method":"DELETE","url":"{{baseUrl}}/feeder/delete-feeder/{{feederId}}"}},
      {"name":"Create Area","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Mirpur 10\",\"feederId\":\"{{feederId}}\"}"},"url":"{{baseUrl}}/area/create-area"}},{"name":"List Areas (Public)","request":{"method":"GET","auth":{"type":"noauth"},"url":"{{baseUrl}}/area/all-areas"}},{"name":"Get Area (Public)","request":{"method":"GET","auth":{"type":"noauth"},"url":"{{baseUrl}}/area/get-area/{{areaId}}"}},{"name":"Update Area","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Mirpur 10 Updated\"}"},"url":"{{baseUrl}}/area/update-area/{{areaId}}"}},{"name":"Delete Area","request":{"method":"DELETE","url":"{{baseUrl}}/area/delete-area/{{areaId}}"}}
    ]},
    {"name":"Outages & Assignments","item":[
      {"name":"Report Outage (Customer)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"description\":\"No power since morning\"}"},"url":"{{baseUrl}}/outages/report"}},{"name":"My Reports","request":{"method":"GET","url":"{{baseUrl}}/outages/my-reports?page=1&limit=10"}},{"name":"Manual Outage","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"feederId\":\"{{feederId}}\"}"},"url":"{{baseUrl}}/outages/manual"}},{"name":"All Outages","request":{"method":"GET","url":"{{baseUrl}}/outages/all-reports?page=1&limit=10"}},{"name":"Outage Details","request":{"method":"GET","url":"{{baseUrl}}/outages/single-outage/{{outageId}}"}},{"name":"Verify Outage","request":{"method":"PATCH","url":"{{baseUrl}}/outages/reports/{{outageId}}/verify"}},{"name":"Close Outage","request":{"method":"PATCH","url":"{{baseUrl}}/outages/close/{{outageId}}"}},
      {"name":"Assign Technician","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"technicianId\":\"{{userId}}\",\"isPriority\":false}"},"url":"{{baseUrl}}/outages/{{outageId}}/assignments"}},{"name":"All Assignments","request":{"method":"GET","url":"{{baseUrl}}/assignments?page=1&limit=10"}},{"name":"Assignment Details","request":{"method":"GET","url":"{{baseUrl}}/assignments/{{assignmentId}}"}},{"name":"Accept Assignment","request":{"method":"PATCH","url":"{{baseUrl}}/assignments/{{assignmentId}}/accept"}},{"name":"Reject Assignment","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"rejectionReason\":\"Unable to reach the location\"}"},"url":"{{baseUrl}}/assignments/{{assignmentId}}/reject"}},{"name":"Start Assignment","request":{"method":"PATCH","url":"{{baseUrl}}/assignments/{{assignmentId}}/start"}},{"name":"Add Repair Update","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"note\":\"Fault isolated and repair underway\"}"},"url":"{{baseUrl}}/assignments/{{assignmentId}}/repair-updates"}},{"name":"Repair Updates","request":{"method":"GET","url":"{{baseUrl}}/assignments/{{assignmentId}}/repair-updates"}},{"name":"Complete Assignment","request":{"method":"PATCH","url":"{{baseUrl}}/assignments/{{assignmentId}}/complete"}},{"name":"My Assignments","request":{"method":"GET","url":"{{baseUrl}}/my-assignments/"}}
    ]},
    {"name":"Schedules, Announcements & Dashboard","item":[
      {"name":"Create Schedule","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\":\"Planned maintenance\",\"reason\":\"Equipment maintenance\",\"startTime\":\"2030-12-01T10:00:00.000Z\",\"endTime\":\"2030-12-01T12:00:00.000Z\",\"areaIds\":[\"{{areaId}}\"],\"powerZoneId\":\"{{zoneId}}\"}"},"url":"{{baseUrl}}/load-shedding-schedules/create"}},{"name":"List Schedules","request":{"method":"GET","url":"{{baseUrl}}/load-shedding-schedules/get-all"}},{"name":"Update Schedule","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\":\"Updated maintenance\"}"},"url":"{{baseUrl}}/load-shedding-schedules/update/{{scheduleId}}"}},{"name":"Approve Schedule","request":{"method":"PATCH","url":"{{baseUrl}}/load-shedding-schedules/{{scheduleId}}/approve"}},{"name":"Cancel Schedule","request":{"method":"PATCH","url":"{{baseUrl}}/load-shedding-schedules/{{scheduleId}}/cancel"}},
      {"name":"Create Announcement","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\":\"Maintenance notice\",\"content\":\"Scheduled maintenance will affect service temporarily.\",\"type\":\"MAINTENANCE\",\"powerZoneId\":\"{{zoneId}}\"}"},"url":"{{baseUrl}}/announcements/create"}},{"name":"Announcement Drafts","request":{"method":"GET","url":"{{baseUrl}}/announcements/drafts"}},{"name":"Update Announcement","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\":\"Updated notice\"}"},"url":"{{baseUrl}}/announcements/drafts/{{announcementId}}/update"}},{"name":"Publish Announcement","request":{"method":"PATCH","url":"{{baseUrl}}/announcements/drafts/{{announcementId}}/publish"}},{"name":"Delete Announcement","request":{"method":"DELETE","url":"{{baseUrl}}/announcements/publish/{{announcementId}}"}},{"name":"Dashboard","request":{"method":"GET","url":"{{baseUrl}}/dashboard/"}}
    ]},
    {"name":"Priority Restoration","item":[{"name":"Create Request","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"outageId\":\"{{outageId}}\",\"reason\":\"Medical emergency\"}"},"url":"{{baseUrl}}/priority-restoration/create"}},{"name":"Payment Callback (bKash)","request":{"method":"GET","auth":{"type":"noauth"},"url":"{{baseUrl}}/priority-restoration/payment/callback"}},{"name":"My Requests","request":{"method":"GET","url":"{{baseUrl}}/priority-restoration/my-requests"}},{"name":"Payment Status","request":{"method":"GET","url":"{{baseUrl}}/priority-restoration/payment/{{priorityRequestId}}"}},{"name":"All Requests","request":{"method":"GET","url":"{{baseUrl}}/priority-restoration/"}}]},
    {"name":"Jobs & Applications","item":[{"name":"Create Job Post","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"title\":\"Field Technician\",\"description\":\"Maintain distribution equipment and respond to outages.\",\"requirements\":\"Electrical diploma\",\"salary\":25000,\"workingHours\":\"9 AM - 5 PM\",\"deadline\":\"2030-12-31\",\"powerZoneId\":\"{{zoneId}}\"}"},"url":"{{baseUrl}}/job-post/create-post"}},{"name":"Admin Job Posts","request":{"method":"GET","url":"{{baseUrl}}/job-post/all-posts"}},{"name":"Public Job Posts","request":{"method":"GET","auth":{"type":"noauth"},"url":"{{baseUrl}}/job-post/public-posts"}},{"name":"Publish Job Post","request":{"method":"PATCH","url":"{{baseUrl}}/job-post/single-post/{{jobPostId}}/publish"}},{"name":"Close Job Post","request":{"method":"PATCH","url":"{{baseUrl}}/job-post/single-post/{{jobPostId}}/close"}},{"name":"Apply (form-data)","request":{"method":"POST","body":{"mode":"formdata","formdata":[{"key":"experience","value":"2 years field experience","type":"text"},{"key":"resume","type":"file","src":""}]},"url":"{{baseUrl}}/job-posts/{{jobPostId}}/applications"}},{"name":"My Applications","request":{"method":"GET","url":"{{baseUrl}}/my-applications/me"}},{"name":"All Applications","request":{"method":"GET","url":"{{baseUrl}}/admin/technician-applications/"}},{"name":"Approve Application","request":{"method":"PATCH","url":"{{baseUrl}}/admin/technician-applications/{{applicationId}}/approve"}},{"name":"Reject Application","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"rejectionReason\":\"Required experience is insufficient\"}"},"url":"{{baseUrl}}/admin/technician-applications/{{applicationId}}/reject"}}]},
    {"name":"User Management","item":[{"name":"Update My Profile","request":{"method":"PATCH","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"Updated Name\",\"phone\":\"01700000000\",\"areaId\":\"{{areaId}}\"}"},"url":"{{baseUrl}}/user/me"}},{"name":"Upload Profile Image","request":{"method":"PATCH","body":{"mode":"formdata","formdata":[{"key":"profileImage","type":"file","src":""}]},"url":"{{baseUrl}}/user/profile-image"}},{"name":"Create Admin","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"New Admin\",\"email\":\"newadmin@example.com\"}"},"url":"{{baseUrl}}/admin/users/admin"}},{"name":"Create Zone Manager","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"name\":\"New Manager\",\"email\":\"manager@example.com\",\"managedZoneId\":\"{{zoneId}}\"}"},"url":"{{baseUrl}}/admin/users/zone-manager"}},{"name":"All Users","request":{"method":"GET","url":"{{baseUrl}}/admin/users/all-users?page=1&limit=10"}},{"name":"Suspend User","request":{"method":"PATCH","url":"{{baseUrl}}/admin/users/{{userId}}/suspend"}},{"name":"Activate User","request":{"method":"PATCH","url":"{{baseUrl}}/admin/users/{{userId}}/activate"}},{"name":"Delete User","request":{"method":"DELETE","url":"{{baseUrl}}/admin/users/{{userId}}/delete"}}]}
  ]
