model TechnicianAssignment {
  id        String           @id @default(uuid())
  status    AssignmentStatus @default(PENDING)
  isPriority Boolean         @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  outageId String
  outage   Outage @relation(fields: [outageId], references: [id])

  technicianId String
  technician   User   @relation("AssignedTechnician", fields: [technicianId], references: [id])

  // Zone Manager assigns (from their own zone's technicians)
  assignedById String
  assignedBy   User   @relation("AssignedBy", fields: [assignedById], references: [id])

  repairUpdates RepairUpdate[]

  @@index([outageId])
  @@index([technicianId])
  @@index([assignedById])
}
