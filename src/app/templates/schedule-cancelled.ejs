<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Load Shedding Cancelled</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f6f8; font-family: Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8; padding:32px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="520" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
          <tr>
            <td style="background-color:#1e3a5f; padding:24px 32px;">
              <h1 style="margin:0; color:#ffffff; font-size:20px;">GridFlow</h1>
              <p style="margin:4px 0 0; color:#c7d4e0; font-size:12px; text-transform:uppercase; letter-spacing:1px;">
                Schedule Update
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <h2 style="margin-top:0; color:#1a1a1a; font-size:18px;">Load shedding cancelled</h2>
              <p style="color:#444444; font-size:14px; line-height:1.6;">
                The previously scheduled load shedding "<strong><%= title %></strong>" (originally planned for
                <%= startTime %> - <%= endTime %>) has been <strong>cancelled</strong>. No outage is expected during this window.
              </p>
            </td>
          </tr>
          <tr>
            <td style="background-color:#fafafa; padding:16px 32px; text-align:center;">
              <p style="margin:0; color:#aaaaaa; font-size:12px;">&copy; <%= new Date().getFullYear() %> GridFlow. All rights reserved.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
