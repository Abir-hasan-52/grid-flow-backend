<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Your GridFlow account has been created</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f6f8; font-family: Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8; padding:32px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
          <tr>
            <td style="background-color:#1e3a5f; padding:24px 32px;">
              <h1 style="margin:0; color:#ffffff; font-size:20px;">GridFlow</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <h2 style="margin-top:0; color:#1a1a1a; font-size:18px;">Your account has been created</h2>
              <p style="color:#444444; font-size:14px; line-height:1.6;">
                Hi <%= name %>,
              </p>
              <p style="color:#444444; font-size:14px; line-height:1.6;">
                An administrator has created a <strong><%= role %></strong> account for you on GridFlow.
                Use the temporary credentials below to log in.
              </p>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:20px 0; background-color:#f0f4f8; border-radius:6px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 6px; color:#1e3a5f; font-size:13px;"><strong>Email:</strong> <%= email %></p>
                    <p style="margin:0; color:#1e3a5f; font-size:13px;"><strong>Temporary Password:</strong>
                      <span style="font-family: monospace; font-size:15px; letter-spacing:1px;"><%= tempPassword %></span>
                    </p>
                  </td>
                </tr>
              </table>

              <p style="color:#c0392b; font-size:13px; line-height:1.6;">
                For security, please log in and change this password as soon as possible. Do not share it with anyone.
              </p>
            </td>
          </tr>
          <tr>
            <td style="background-color:#fafafa; padding:16px 32px; text-align:center;">
              <p style="margin:0; color:#aaaaaa; font-size:12px;">&copy; <%= new Date().getFullYear() %> GridFlow. All rights reserved.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
