<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Load Shedding Notice</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f6f8; font-family: Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8; padding:32px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="520" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
          <tr>
            <td style="background-color:#8a5a00; padding:24px 32px;">
              <h1 style="margin:0; color:#ffffff; font-size:20px;">GridFlow</h1>
              <p style="margin:4px 0 0; color:#f0e0c0; font-size:12px; text-transform:uppercase; letter-spacing:1px;">
                Scheduled Load Shedding
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <h2 style="margin-top:0; color:#1a1a1a; font-size:18px;"><%= title %></h2>
              <p style="color:#444444; font-size:14px; line-height:1.6;">
                A power outage has been scheduled for your area.
              </p>
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0; background-color:#fdf6e8; border-radius:6px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 6px; color:#8a5a00; font-size:13px;"><strong>Starts:</strong> <%= startTime %></p>
                    <p style="margin:0; color:#8a5a00; font-size:13px;"><strong>Ends:</strong> <%= endTime %></p>
                  </td>
                </tr>
              </table>
              <% if (reason) { %>
              <p style="color:#888888; font-size:13px; line-height:1.6;">Reason: <%= reason %></p>
              <% } %>
              <p style="color:#444444; font-size:14px; line-height:1.6;">
                Please plan accordingly. We apologize for any inconvenience.
              </p>
            </td>
          </tr>
          <tr>
            <td style="background-color:#fafafa; padding:16px 32px; text-align:center;">
              <p style="margin:0; color:#aaaaaa; font-size:12px;">&copy; <%= new Date().getFullYear() %> GridFlow. All rights reserved.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
