<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Reset Your Password</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f6f8; font-family: Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f6f8; padding:32px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="480" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,0.08);">
          <tr>
            <td style="background-color:#1e3a5f; padding:24px 32px;">
              <h1 style="margin:0; color:#ffffff; font-size:20px;">GridFlow</h1>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <h2 style="margin-top:0; color:#1a1a1a; font-size:18px;">Reset your password</h2>
              <p style="color:#444444; font-size:14px; line-height:1.6;">
                Hi<% if (typeof userName !== 'undefined' && userName) { %> <%= userName %><% } %>,
              </p>
              <p style="color:#444444; font-size:14px; line-height:1.6;">
                We received a request to reset your GridFlow account password. Use the OTP below to continue. This code will expire in
                <strong><%= typeof expiresInMinutes !== 'undefined' ? expiresInMinutes : 5 %> minutes</strong>.
              </p>
              <div style="text-align:center; margin:32px 0;">
                <span style="display:inline-block; background-color:#f0f4f8; color:#1e3a5f; font-size:28px; letter-spacing:6px; font-weight:bold; padding:14px 28px; border-radius:6px;">
                  <%= otp %>
                </span>
              </div>
              <p style="color:#888888; font-size:13px; line-height:1.6;">
                If you did not request a password reset, you can safely ignore this email — your password will remain unchanged.
                Never share this OTP with anyone, including GridFlow staff.
              </p>
            </td>
          </tr>
          <tr>
            <td style="background-color:#fafafa; padding:16px 32px; text-align:center;">
              <p style="margin:0; color:#aaaaaa; font-size:12px;">&copy; <%= new Date().getFullYear() %> GridFlow. All rights reserved.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
